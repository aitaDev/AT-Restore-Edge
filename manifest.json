{
  "manifest_version": 3,
  "name": "AT-Restore for Edge",
  "version": "1.0.3",
  "description": "Crash-safe text field autosave and recovery for Microsoft Edge.",
  "permissions": ["storage", "tabs", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "AT-Restore for Edge", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
